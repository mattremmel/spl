// SPL Prelude - automatically imported into all SPL programs.
//
// TODO: Once type conversion methods (.widen(), .truncate(), .try_into())
// are implemented, update the print functions to use those instead of
// relying on implicit conversion or extern type matching.

// Extern declarations for runtime intrinsics.
// Parameter types match the str builtin method return types to avoid casts.
extern "C" {
    fn __print_str(_ ptr: i64, _ len: i64);
    fn __print_newline();
}

/// Print a string to stdout (no newline).
pub fn print(_ s: str) {
    // Direct pass-through; codegen handles ptr/len extraction from str
    __print_str(s.ptr(), s.len());
}

/// Print a string to stdout followed by a newline.
pub fn println(_ s: str) {
    print(s);
    __print_newline();
}
